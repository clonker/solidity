#0:
    v0 = const 0x00
    v1 = const 0x01
    v3 = builtin @calldataload v0
    upsilon v0 -> ^v10
    upsilon v3 -> ^v11
    jump #1
#1: preds: #0, #1
    v10 = phi
    v11 = phi
    v12 = builtin @add v10, v1
    upsilon v12 -> ^v10
    v13 = builtin @add v11, v10
    upsilon v13 -> ^v11
    v14 = builtin @lt v12, v3
    branch v14, #1, #2
#2: preds: #1
    builtin @sstore v0, v10
    builtin @sstore v1, v11
    main_exit
