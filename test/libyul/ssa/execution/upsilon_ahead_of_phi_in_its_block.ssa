#0:
    v0 = const 0x00
    v1 = const 0x01
    v3 = builtin @calldataload v0
    upsilon v0 -> ^v10
    jump #1
#1: preds: #0, #1
    v10 = phi
    v11 = builtin @add v10, v1
    upsilon v11 -> ^v20
    v20 = phi
    upsilon v20 -> ^v10
    builtin @sstore v20, v11
    v12 = builtin @lt v20, v3
    branch v12, #1, #2
#2: preds: #1
    builtin @sstore v0, v20
    main_exit
