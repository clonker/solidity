#0:
    v0 = const 0x00
    v1 = const 0x01
    v2 = const 0x02
    v3 = builtin @calldataload v0
    v4 = builtin @mul v3, v2
    upsilon v4 -> ^v40
    upsilon v0 -> ^v10
    upsilon v0 -> ^v11
    jump #1
#1: preds: #0, #2
    v10 = phi
    v11 = phi
    v12 = builtin @lt v10, v3
    branch v12, #2, #3
#2: preds: #1
    v20 = builtin @add v11, v10
    upsilon v20 -> ^v11
    v21 = builtin @add v10, v1
    upsilon v21 -> ^v10
    jump #1
#3: preds: #1
    builtin @sstore v1, v11
    jump #4
#4: preds: #3
    v40 = phi
    builtin @sstore v0, v40
    main_exit
