    branch v21, #3, #5
#3: preds: #2, #5
    builtin @sstore v11, v10
    jump #1
#5: preds: #2
    upsilon v10 -> ^v10
    jump #3
#4: preds: #1
    builtin @sstore v0, v10
    builtin @sstore v1, v11
    main_exit
