#0:
    v0 = const 0x00
    v1 = const 0x01
    v2 = const 0x02
    v3 = builtin @calldataload v0
    upsilon v0 -> ^v10
    upsilon v2 -> ^v40
    jump #1
#1: preds: #0, #2
    v10 = phi
    v11 = builtin @lt v10, v3
    branch v11, #2, #3
#2: preds: #1
    v20 = builtin @mul v10, v10
    upsilon v20 -> ^v40
    v21 = builtin @add v10, v1
    upsilon v21 -> ^v10
    jump #1
#3: preds: #1
    builtin @sstore v1, v10
    jump #4
#4: preds: #3
    v40 = phi
    builtin @sstore v0, v40
    main_exit
