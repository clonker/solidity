    v1 = const 0x01
    v2 = const 0x02
    v3 = const 0x03
    v4 = builtin @calldataload v0
    v5 = builtin @and v4, v1
    v6 = builtin @add v4, v3
    upsilon v6 -> ^v30
    branch v5, #1, #2
#1: preds: #0
