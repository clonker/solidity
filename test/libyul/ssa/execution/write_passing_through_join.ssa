    upsilon v10 -> ^v30
    builtin @sstore v1, v10
    jump #3
#2: preds: #0
    builtin @sstore v2, v4
    jump #3
#3: preds: #1, #2
    v20 = builtin @shr v1, v4
    builtin @sstore v3, v20
    jump #4
#4: preds: #3
    v30 = phi
    builtin @sstore v0, v30
    main_exit
