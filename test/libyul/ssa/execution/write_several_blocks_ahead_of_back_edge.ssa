#0:
    v0 = const 0x00
    v1 = const 0x01
    v2 = const 0x02
    v3 = builtin @calldataload v0
    upsilon v0 -> ^v10
    upsilon v1 -> ^v11
    jump #1
#1: preds: #0, #4
    v10 = phi
    v11 = phi
    v12 = builtin @lt v10, v3
    branch v12, #2, #5
#2: preds: #1
    v20 = builtin @add v10, v1
    upsilon v20 -> ^v10
    v21 = builtin @mul v11, v2
    upsilon v21 -> ^v11
    branch v10, #3, #4
#3: preds: #2
    builtin @sstore v20, v21
    jump #4
#4: preds: #2, #3
    v40 = builtin @add v11, v10
    builtin @sstore v0, v40
    jump #1
#5: preds: #1
    builtin @sstore v1, v11
    main_exit
