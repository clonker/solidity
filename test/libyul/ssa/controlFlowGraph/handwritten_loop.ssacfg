// A counting loop written down in the printer's syntax: the graph is taken as it is, no transform runs on it.
#0:
    v0 = const 0x00
    v1 = builtin @calldataload v0
    v2 = const 0x0a
    v3 = const 0x01
    upsilon v0 -> ^v4
    upsilon v1 -> ^v5
    jump #1
#1: preds: #0, #3
    v4 = phi
    v5 = phi
    v6 = builtin @lt v4, v2
    branch v6, #2, #4
#2: preds: #1
    v7 = builtin @mload v4
    v8 = builtin @add v5, v7
    jump #3
#3: preds: #2
    v9 = builtin @add v4, v3
    upsilon v9 -> ^v4
    upsilon v8 -> ^v5
    jump #1
#4: preds: #1
    builtin @sstore v3, v5
    main_exit
